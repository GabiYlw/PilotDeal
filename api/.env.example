# Development database (docker compose up -d db)
DATABASE_URL=postgresql://dealpilot:dealpilot@localhost:5432/dealpilot
# Separate database used only by integration tests
DATABASE_URL_TEST=postgresql://dealpilot:dealpilot@localhost:5432/dealpilot_test
PORT=3001
# Optional. Without it the app uses rule-based scoring and no generated answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
