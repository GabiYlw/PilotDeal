# Development database (docker compose up -d db)
DATABASE_URL=postgresql://pilotdeal:pilotdeal@localhost:5432/pilotdeal
# Separate database used only by integration tests
DATABASE_URL_TEST=postgresql://pilotdeal:pilotdeal@localhost:5432/pilotdeal_test
PORT=3001
# Optional. Without it, next-action scoring is rule-based and /ask returns no generated answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
