{
  "name": "pilotdeal-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "embed:backfill": "tsx src/scripts/embed-backfill.ts",
    "postinstall": "prisma generate",
    "format": "prettier . --write --ignore-path ../.prettierignore --ignore-path ../.gitignore",
    "format:check": "prettier . --check --ignore-path ../.prettierignore --ignore-path ../.gitignore",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "embed:download": "tsx src/scripts/download-embedding-model.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
