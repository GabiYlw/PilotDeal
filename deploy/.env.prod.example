# Server .env for docker-compose.prod.yml. Copy to .env in the repository root on the server,
# chmod 600, and never commit it.

# Required. URL-safe, for example: openssl rand -hex 32
POSTGRES_PASSWORD=

# Optional. Domain Caddy serves and gets certificates for (www. redirects to it).
SITE_DOMAIN=pilotdeal.online

# Optional. Without a key, scoring is rule-based and Ask the Pilot returns sources only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
